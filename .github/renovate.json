{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":groupAll",
    "schedule:monthly"
  ],
  "onboarding": true,
  "requireConfig": "ignored",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "timezone": "Europe/Paris",
  "baseBranches": ["staging"],
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "enabledManagers": ["npm", "dockerfile", "github-actions"],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/.next/**"],
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies",
      "matchPackageNames": ["*"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "schedule": ["before 5am on the first day of the month"]
}
